# Copy this file to .env (which is git-ignored) and fill in real values.
# Claude Code does NOT read .env automatically - the variables must be set in the
# environment before Claude Code starts. See docs/mcp-setup.md.

# GitHub fine-grained personal access token for the TEST GitHub account.
# Referenced from .mcp.json as ${GITHUB_PAT}.
GITHUB_PAT=

# Add one line per extra service that needs a token, e.g.:
# SOME_SERVICE_API_KEY=
